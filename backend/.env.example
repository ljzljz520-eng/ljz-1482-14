# 数据库（docker-compose 中由服务名 db 提供）
DATABASE_URL=postgresql://audiovisual:audiovisual@db:5432/audiovisual?schema=public
# 存储目录
STORAGE_DIR=/data/storage
# 分块上传单文件大小上限（字节，默认 500MiB）
MAX_UPLOAD_BYTES=524288000
# 远程下载大小上限（字节，默认 50MiB）
MAX_REMOTE_BYTES=52428800
# 远程下载超时（毫秒）
REMOTE_TIMEOUT_MS=15000
# 同步探测超时（毫秒），超时回退异步探测
SYNC_PROBE_MS=800
# 允许被远程拉取的主机（逗号分隔）；默认仅示例图床
REMOTE_ALLOWED_HOSTS=images.unsplash.com,commondatastorage.googleapis.com
# 是否在进程内运行异步转码 worker
WORKER_ENABLED=true
# ffmpeg / ffprobe 可执行文件
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
LOG_LEVEL=info
PORT=8000
