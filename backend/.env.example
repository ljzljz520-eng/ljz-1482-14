# 本地开发（Docker 内置 mysql://park:park@db:3306/park_media）
NODE_ENV=development
PORT=8080
DATABASE_URL=mysql://park:park@localhost:3306/park_media
JWT_SECRET=change-me-in-production
STORAGE_ROOT=./data
MAX_ASSET_BYTES=524288000
MAX_REMOTE_BYTES=209715200
REMOTE_MAX_REDIRECTS=3
REMOTE_ALLOW_HOSTS=fixtures,fixtures.local
REMOTE_FETCH_TIMEOUT_MS=30000
TRANSCODE_CONCURRENCY=2
